corpus/

# PDF→Markdown 변환 파이프라인, 글리프 복원, 코퍼스 측정 스크립트
tools/

# 측정 원본 데이터
analysis/

# 레퍼런스 폰트, 모양 대조 뱅크, 글리프 캐시
refs/

# 스킬을 시험해 보며 만든 예제 원고
drafts/

